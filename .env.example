# RealEstateOS Security & Environment Variables Example
# Copy this file to .env and set your own values.

# Google Gemini API Key (Required for AI generation features)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model ID (Optional - defaults to latest gemini-3.1-pro)
GEMINI_MODEL_ID=gemini-3.1-pro

# Admin Email (Required - 2FA authentication codes will be sent here)
ADMIN_EMAIL=your_email@example.com

# Master Application Password (Required - set a strong password)
APP_PASSWORD=your_strong_master_password_here

# JWT Secret Key (Required - random 32+ character string for signing session tokens)
JWT_SECRET=your_secret_signing_key_at_least_32_chars_long

# Optional SMTP Email Configuration for sending 2FA OTP emails in production
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM="RealEstateOS Security <noreply@yourdomain.com>"

# Optional Resend API Key (Alternative to SMTP)
# RESEND_API_KEY=your_resend_api_key
